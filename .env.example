# Firebase runtime configuration exposed in the Expo client bundle.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_DB_URL=https://<project-id>-default-rtdb.<region>.firebasedatabase.app

# Optional runtime error reporting. This value is public in the client bundle.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry build configuration. Keep the auth token in CI/EAS secrets.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=__set_in_ci_only__
SENTRY_URL=https://sentry.io/
